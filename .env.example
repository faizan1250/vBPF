# vBPF example environment. Mock-only: CI sets LLM_MODE=mock and reads no
# secrets from here. NEVER commit real keys; provider keys are local-only
# (.env, gitignored) and must never be added to GitHub Actions secrets for
# CI — CI always takes the LLM_UNAVAILABLE fallback path instead.

# mock (default, CI-safe) or live (requires provider key, never in CI).
LLM_MODE=mock
# Ordered live-provider chain (R-01). Presets: groq, cerebras, openrouter,
# ollama, gemini, openai, anthropic, custom (custom needs
# LLM_CUSTOM_BASE_URL). `anthropic` uses the native Messages API
# (https://api.anthropic.com/v1/messages); its default JSON mode is
# instruction-only, so set LLM_ANTHROPIC_JSON_MODE=tool for forced structure.
LLM_PROVIDER_CHAIN=groq

# Live provider keys: local .env ONLY. Never commit, never CI. For NAME in
# the chain the client reads LLM_<NAME>_API_KEY, <NAME>_API_KEY, then
# <NAME>_API_KEY1..5 (stops at the first numbering gap).
# GROQ_API_KEY=
# LLM_GROQ_MODEL= (free model IDs change; list current ones via the
#   provider's models endpoint, e.g. GET <base>/models)
# LLM_GROQ_FALLBACK_MODELS= (comma-separated, same provider, same key)
# LLM_GROQ_JSON_MODE= (json_object default | tool | none; a provider that
#   rejects JSON shaping drops to none for the process and retries once)
# LLM_GROQ_BASE_URL= (override the groq preset when valid; an invalid value
#   leaves the provider unconfigured and nothing is sent to it)
# LLM_CUSTOM_BASE_URL= (for the custom chain entry; Gemini's OpenAI-compat
#   base is https://generativelanguage.googleapis.com/v1beta/openai)

# Per-request deadline (headers + body share one timer) and overall budget
# per generate/explain call: each attempt uses min(per-request, remaining).
# LLM_TIMEOUT_MS=45000
# LLM_TOTAL_TIMEOUT_MS=90000
# Queueing behind the 4 concurrent provider slots:
# LLM_MAX_WAITERS=10
# LLM_WAIT_TIMEOUT_MS=10000

# Local service endpoints (defaults mirror the port reservations below).
AGENT_URL=http://127.0.0.1:8787
AGENT_TOKEN_FILE=./run/agent.token
# AGENT_ALLOWED_ORIGINS= (comma-separated WS origin allowlist; unset refuses all browser origins)

# API server (api/src/config.ts; defaults shown).
PORT=8080
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173
# Trust boundary for X-Forwarded-For (api/src/server.ts parseTrustProxy):
# "false" (default) trusts no proxy and rate-limits on the socket address.
# In compose this is set to the nginx service network (172.28.0.0/16) so the
# limiter keys on the real client IP. Set it to the peer IP/CIDR allowlist
# whenever the API sits behind a proxy you control, and only then. "true"
# trusts everyone (never with untrusted clients); bare hop counts fail
# closed to "false" because the immediate peer cannot be validated.
# TRUST_PROXY=false
DATABASE_PATH=./run/api.sqlite3
RECIPES_DIR=./recipes

# Safety caps for generated bpftrace probes.
MAX_DURATION_S=60
DEFAULT_DURATION_S=10

# bpftrace resource guards.
BPFTRACE_MAP_KEYS_MAX=4096
BPFTRACE_MAX_PROBES=50
BPFTRACE_STRLEN=64

# Reserved ports: web 5173, api 8080, agent 8787 (loopback only).
